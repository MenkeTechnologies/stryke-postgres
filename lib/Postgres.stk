# lib/Postgres.stk — PostgreSQL client for stryke (`use Postgres`).
#
# Thin wrapper around the `stryke-postgres` cdylib's `pg__*` exports.
# The cdylib is dlopened in-process on first `use Postgres` (see stryke's
# `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
# stryke-callable function via `rust_ffi::load_cdylib`.
#
# Replaces the v1 helper-binary model (fork(2) + exec(2) + fresh TCP+TLS+
# auth handshake per call). The cdylib caches one `postgres::Client` per
# connection URL — back-to-back calls reuse the same connection object.

package Postgres

# ── error dispatch ────────────────────────────────────────────────────

fn Postgres::_decode ($name, $json) {
    my $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "Postgres::$name: $o->{error}"
    }
    $o
}

fn Postgres::_req ($extra, $opts) {
    my %r = %$extra
    for my $k (qw(url host port user password database)) {
        $r{$k} = $opts->{$k} if exists $opts->{$k} && defined $opts->{$k}
    }
    if (!exists $r{url} && !exists $r{host}) {
        $r{url} = $ENV{DATABASE_URL} // $ENV{POSTGRES_URL} if defined ($ENV{DATABASE_URL} // $ENV{POSTGRES_URL})
    }
    \%r
}

# ── version + ping ──────────────────────────────────────────────────

fn Postgres::version {
    Postgres::_decode("pkg_version", pg__pkg_version("{}"))->{version}
}

fn Postgres::server_version (%opts) {
    Postgres::_decode("version",
        pg__version(to_json(Postgres::_req({}, \%opts))))->{version}
}

fn Postgres::ping (%opts) {
    Postgres::_decode("ping",
        pg__ping(to_json(Postgres::_req({}, \%opts))))->{ok} ? 1 : 0
}

# ── metadata ────────────────────────────────────────────────────────

fn Postgres::databases (%opts) {
    my $o = Postgres::_decode("databases",
        pg__databases(to_json(Postgres::_req({}, \%opts))))
    @{ $o->{databases} }
}

fn Postgres::tables (%opts) {
    my $o = Postgres::_decode("tables",
        pg__tables(to_json(Postgres::_req({}, \%opts))))
    @{ $o->{tables} }
}

fn Postgres::schema ($table, %opts) {
    Postgres::_decode("schema",
        pg__schema(to_json(Postgres::_req({ table => $table }, \%opts))))
}

# ── read paths ──────────────────────────────────────────────────────

fn Postgres::query ($sql, %opts) {
    Postgres::_query_impl($sql, \%opts)
}

fn Postgres::_query_impl ($sql, $o) {
    my $r = Postgres::_req({ sql => $sql, params => $o->{bind} }, $o)
    my $res = Postgres::_decode("query", pg__query(to_json($r)))
    @{ $res->{rows} }
}

fn Postgres::query_one ($sql, %opts) {
    my @r = Postgres::_query_impl($sql, \%opts)
    @r ? $r[0] : undef
}

fn Postgres::query_col ($sql, %opts) {
    my @rows = Postgres::_query_impl($sql, \%opts)
    return () unless @rows
    my @keys = keys %{ $rows[0] }
    my $first = $keys[0]
    map { $_->{$first} } @rows
}

fn Postgres::query_scalar ($sql, %opts) {
    my @r = Postgres::_query_impl($sql, \%opts)
    return undef unless @r
    my @keys = keys %{ $r[0] }
    $r[0]->{$keys[0]}
}

# Callback fires per row; cdylib returns all rows in one call.
fn Postgres::query_stream ($sql, %opts) {
    die "Postgres::query_stream: callback => sub { … } required" unless defined $opts{callback}
    my $cb = $opts{callback}
    my @rows = Postgres::_query_impl($sql, \%opts)
    my $n = 0
    for my $row (@rows) {
        $cb->($row)
        $n++
    }
    $n
}

fn Postgres::dump ($table, %opts) {
    my $r = Postgres::_req({ table => $table, limit => $opts{limit} }, \%opts)
    my $res = Postgres::_decode("dump", pg__dump(to_json($r)))
    @{ $res->{rows} }
}

# ── DDL / DML ───────────────────────────────────────────────────────

fn Postgres::execute ($sql, %opts) {
    my $r = Postgres::_req({ sql => $sql, params => $opts{bind} }, \%opts)
    Postgres::_decode("execute", pg__execute(to_json($r)))
}

fn Postgres::exec_file ($path, %opts) {
    die "Postgres::exec_file: file `$path` not found" unless -e $path
    open my $fh, "<", $path or die "Postgres::exec_file: open $path: $!"
    local $/
    my $sql = <$fh>
    close $fh
    my $r = Postgres::_req({ sql => $sql }, \%opts)
    Postgres::_decode("exec", pg__exec(to_json($r)))
}

fn Postgres::insert_many ($table, $rows, %opts) {
    die "Postgres::insert_many: rows must be arrayref of hashrefs" unless ref($rows) eq "ARRAY"
    my $r = Postgres::_req({ table => $table, rows => $rows }, \%opts)
    Postgres::_decode("insert_many", pg__insert_many(to_json($r)))->{inserted}
}

1
