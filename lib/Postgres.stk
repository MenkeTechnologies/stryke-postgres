## lib/Postgres.stk — PostgreSQL client for stryke (`use Postgres`).
##
## Thin wrapper around the `stryke-postgres` cdylib's `pg__*` exports.
## The cdylib is dlopened in-process on first `use Postgres` (see stryke's
## `pkg/commands.rs::try_load_ffi_for`) and registers each export as a
## stryke-callable function via `rust_ffi::load_cdylib`.
##
## Replaces the v1 helper-binary model (fork(2) + exec(2) + fresh TCP+TLS+
## auth handshake per call). The cdylib caches one `postgres::Client` per
## connection URL — back-to-back calls reuse the same connection object.

package Postgres

# ── error dispatch ────────────────────────────────────────────────────

## Decode the cdylib's JSON return; die on `{error}` payload.
fn Postgres::_decode ($name, $json) {
    val $o = from_json $json
    if (ref $o eq "HASH" && exists $o->{error}) {
        die "Postgres::$name: $o->{error}"
    }
    $o
}

## Build the FFI request hash by merging the caller's connection opts.
fn Postgres::_req ($extra, $opts) {
    var %r = %$extra
    for val $k (qw(url host port user password database)) {
        $r{$k} = $opts->{$k} if exists $opts->{$k} && defined $opts->{$k}
    }
    if (!exists $r{url} && !exists $r{host}) {
        $r{url} = $ENV{DATABASE_URL} // $ENV{POSTGRES_URL} if defined ($ENV{DATABASE_URL} // $ENV{POSTGRES_URL})
    }
    \%r
}

# ── version + ping ──────────────────────────────────────────────────

## Return the package version string.
fn Postgres::version {
    Postgres::_decode("pkg_version", pg__pkg_version("{}"))->{version}
}

## Postgres `version()` — server build string.
fn Postgres::server_version (%opts) {
    Postgres::_decode("version",
        pg__version(to_json(Postgres::_req({}, \%opts))))->{version}
}

## Connectivity probe — returns 1 on success, 0 on failure.
fn Postgres::ping (%opts) {
    Postgres::_decode("ping",
        pg__ping(to_json(Postgres::_req({}, \%opts))))->{ok} ? 1 : 0
}

# ── metadata ────────────────────────────────────────────────────────

## List databases (non-template).
fn Postgres::databases (%opts) {
    val $o = Postgres::_decode("databases",
        pg__databases(to_json(Postgres::_req({}, \%opts))))
    @{ $o->{databases} }
}

## List tables in the public schema.
fn Postgres::tables (%opts) {
    val $o = Postgres::_decode("tables",
        pg__tables(to_json(Postgres::_req({}, \%opts))))
    @{ $o->{tables} }
}

## Column metadata for $table.
fn Postgres::schema ($table, %opts) {
    Postgres::_decode("schema",
        pg__schema(to_json(Postgres::_req({ table => $table }, \%opts))))
}

# ── read paths ──────────────────────────────────────────────────────

## Run a SELECT and return rows as hashrefs.
fn Postgres::query ($sql, %opts) {
    Postgres::_query_impl($sql, \%opts)
}

## Internal query implementation; see public wrappers.
fn Postgres::_query_impl ($sql, $o) {
    val $r = Postgres::_req({ sql => $sql, params => $o->{bind} }, $o)
    val $res = Postgres::_decode("query", pg__query(to_json($r)))
    @{ $res->{rows} }
}

## Run a SELECT LIMIT 1; return one row hashref or undef.
fn Postgres::query_one ($sql, %opts) {
    val @r = Postgres::_query_impl($sql, \%opts)
    @r ? $r[0] : undef
}

## Run a SELECT; return the first column as a flat list.
fn Postgres::query_col ($sql, %opts) {
    val @rows = Postgres::_query_impl($sql, \%opts)
    return () unless @rows
    val @keys = keys %{ $rows[0] }
    val $first = $keys[0]
    map { $_->{$first} } @rows
}

## Run a SELECT LIMIT 1; return the first cell.
fn Postgres::query_scalar ($sql, %opts) {
    val @r = Postgres::_query_impl($sql, \%opts)
    return undef unless @r
    val @keys = keys %{ $r[0] }
    $r[0]->{$keys[0]}
}

## Callback fires per row; cdylib returns all rows in one call.
fn Postgres::query_stream ($sql, %opts) {
    die "Postgres::query_stream: callback => sub { … } required" unless defined $opts{callback}
    val $cb = $opts{callback}
    val @rows = Postgres::_query_impl($sql, \%opts)
    var $n = 0
    for val $row (@rows) {
        $cb->($row)
        $n++
    }
    $n
}

## SELECT * FROM $table [LIMIT N] shorthand.
fn Postgres::dump ($table, %opts) {
    val $r = Postgres::_req({ table => $table, limit => $opts{limit} }, \%opts)
    val $res = Postgres::_decode("dump", pg__dump(to_json($r)))
    @{ $res->{rows} }
}

# ── DDL / DML ───────────────────────────────────────────────────────

## Run a non-SELECT statement; returns { affected }.
fn Postgres::execute ($sql, %opts) {
    val $r = Postgres::_req({ sql => $sql, params => $opts{bind} }, \%opts)
    Postgres::_decode("execute", pg__execute(to_json($r)))
}

## Read SQL from $path and run as a multi-statement script.
fn Postgres::exec_file ($path, %opts) {
    die "Postgres::exec_file: file `$path` not found" unless -e $path
    open val $fh, "<", $path or die "Postgres::exec_file: open $path: $!"
    local $/
    val $sql = <$fh>
    close $fh
    val $r = Postgres::_req({ sql => $sql }, \%opts)
    Postgres::_decode("exec", pg__exec(to_json($r)))
}

## Bulk INSERT $rows (arrayref of hashrefs) into $table.
fn Postgres::insert_many ($table, $rows, %opts) {
    die "Postgres::insert_many: rows must be arrayref of hashrefs" unless ref($rows) eq "ARRAY"
    val $r = Postgres::_req({ table => $table, rows => $rows, returning => $opts{returning} }, \%opts)
    val $res = Postgres::_decode("insert_many", pg__insert_many(to_json($r)))
    # With a RETURNING clause the generated rows come back; without it, the
    # plain inserted-row count.
    defined($opts{returning}) ? @{ $res->{rows} } : $res->{inserted}
}


# ── transactions ────────────────────────────────────────────────────
#
# Postgres caches one connection per (url/host/db/auth) tuple for the life
# of the process, so BEGIN / your statements / COMMIT issued with the SAME
# connection params all run on the SAME backend connection. These wrappers
# ride on that affinity — no new FFI export needed. NB: a transaction is
# not atomic across threads sharing one connection tuple; use distinct
# connections (e.g. different db) for concurrent transactions.
#
# Every internal call forwards the connection params as EXPLICIT inline
# pairs via `_conn` rather than splatting %opts: stryke drops a splatted
# hash variable's keys when the callee is a store-loaded package fn
# (BUG-306), which would silently route to the default server / DATABASE_URL.

## Connection params from $opts (a hashref) as a flat inline list, ready
## to splice straight into a call's argument list — never `%`-splatted.
fn Postgres::_conn ($opts) {
    var @c
    for val $k (qw(url host port user password database)) {
        push @c, $k, $opts->{$k} if defined $opts->{$k}
    }
    @c
}

## Open a transaction: BEGIN on the connection for %opts.
fn Postgres::begin (%opts) {
    Postgres::execute("BEGIN", Postgres::_conn(\%opts))
    1
}

## Commit the open transaction on the connection for %opts.
fn Postgres::commit (%opts) {
    Postgres::execute("COMMIT", Postgres::_conn(\%opts))
    1
}

## Roll back the open transaction on the connection for %opts.
fn Postgres::rollback (%opts) {
    Postgres::execute("ROLLBACK", Postgres::_conn(\%opts))
    1
}

## Run $code inside a transaction: BEGIN, call $code->(), then COMMIT.
## If $code dies, ROLLBACK and re-raise the original error. Returns
## whatever $code returned. $code is a coderef; pass connection params in
## %opts and reference them via closure, e.g.
##   Postgres::transaction(fn {
##       Postgres::execute("INSERT ...", %c)
##       Postgres::execute("UPDATE ...", %c)
##   }, %c)
fn Postgres::transaction ($code, %opts) {
    die "Postgres::transaction: first arg must be a coderef" unless ref($code) eq "CODE"
    Postgres::begin(Postgres::_conn(\%opts))
    val $r = eval { $code->() }
    if ($@) {
        eval { Postgres::rollback(Postgres::_conn(\%opts)) }
        die $@
    }
    Postgres::commit(Postgres::_conn(\%opts))
    $r
}

# ── convenience reads / DDL ─────────────────────────────────────────

## Number of rows in $table (optionally matching a WHERE clause passed
## as $where, with binds in %opts{bind}). The table name is an identifier
## and is interpolated — pass only trusted/validated names.
fn Postgres::count ($table, $where = undef, %opts) {
    val $sql = defined($where) && length($where)
        ? "SELECT count(*) AS n FROM $table WHERE $where"
        : "SELECT count(*) AS n FROM $table"
    var @fwd = Postgres::_conn(\%opts)
    push @fwd, bind => $opts{bind} if defined $opts{bind}
    Postgres::query_scalar($sql, @fwd) + 0
}

## True if a table named $name exists in the current database. $name must
## be a plain SQL identifier ([A-Za-z_][A-Za-z0-9_]*); anything else dies.
## The identifier check makes the inlined literal injection-safe (a bound
## parameter would be cleaner, but stryke drops the bind when a slurpy
## %opts is re-forwarded from a store-loaded wrapper — see BUGS note).
fn Postgres::table_exists ($name, %opts) {
    unless ($name =~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
        die "Postgres::table_exists: name must be a plain identifier, got `$name`"
    }
    Postgres::query_scalar(
        "SELECT count(*) FROM information_schema.tables WHERE table_name = '$name'",
        Postgres::_conn(\%opts)) > 0 ? 1 : 0
}

## TRUNCATE $table (optionally RESTART IDENTITY when restart_identity is
## set). The table name is interpolated — pass only trusted names.
fn Postgres::truncate ($table, %opts) {
    val $sql = $opts{restart_identity}
        ? "TRUNCATE TABLE $table RESTART IDENTITY"
        : "TRUNCATE TABLE $table"
    Postgres::execute($sql, Postgres::_conn(\%opts))
    1
}
