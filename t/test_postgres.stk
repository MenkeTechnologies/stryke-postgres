## t/test_postgres.stk — assertion tests for the stryke `Postgres` package.
##
## Uses stryke's native test framework (`assert_*` + `test_run`).
## Requires the cdylib to be loaded — install once with `s pkg install -g .`
## so stryke's FFI bridge dlopens `lib/libstryke_postgres.{dylib,so}` on
## `use Postgres`. Live tests use a unique table `stryke_postgres_test_$$`
## when $DATABASE_URL (or $POSTGRES_URL / $POSTGRES_DSN) is reachable.

use Postgres

# ── permission-free: cdylib reachable ───────────────────────────────
val $version = Postgres::version()
assert_ok $version, "Postgres::version returns truthy (cdylib loaded)"

# ── liveness probe ──────────────────────────────────────────────────
val $dsn = $ENV{DATABASE_URL} // $ENV{POSTGRES_URL} // $ENV{POSTGRES_DSN}
val $alive = defined $dsn && $dsn ne "" && eval { Postgres::ping(url => $dsn) }

if ($alive) {
    val $tbl = "stryke_postgres_test_$$"
    eval { Postgres::execute("DROP TABLE IF EXISTS $tbl", url => $dsn) }

    # create
    Postgres::execute(
        "CREATE TABLE $tbl (id SERIAL PRIMARY KEY, name TEXT, score DOUBLE PRECISION, payload JSONB)",
        url => $dsn,
    )
    assert_ok 1, "create table"

    # insert with positional binds + JSONB payload
    val $ins = Postgres::execute(
        "INSERT INTO $tbl (name, score, payload) VALUES (\$1,\$2,\$3),(\$4,\$5,\$6),(\$7,\$8,\$9)",
        url  => $dsn,
        bind => ["alice", 1.5, {color => "blue"},
                 "bob",   2.0, {color => "red"},
                 "charlie", 3.25, {color => "green"}],
    )
    assert_eq $ins->{affected}, 3, "insert: affected=3"

    # select
    val @rows = Postgres::query("SELECT * FROM $tbl ORDER BY id", url => $dsn)
    assert_eq scalar(@rows), 3, "select: 3 rows"

    # bind in query
    val @bobs = Postgres::query("SELECT * FROM $tbl WHERE name = \$1", url => $dsn, bind => ["bob"])
    assert_eq scalar(@bobs), 1, "bind query: 1 row"
    assert_eq $bobs[0]->{name}, "bob", "bind query: name=bob"

    # query_scalar
    assert_eq Postgres::query_scalar("SELECT COUNT(*) AS n FROM $tbl", url => $dsn), 3, "query_scalar count"

    # query_one with jsonb decode
    val $one = Postgres::query_one("SELECT * FROM $tbl WHERE name = \$1", url => $dsn, bind => ["alice"])
    assert_eq $one->{name}, "alice", "query_one: name"
    assert_eq $one->{payload}->{color}, "blue", "query_one: jsonb payload decoded"

    # query_col
    val @names = Postgres::query_col("SELECT name FROM $tbl ORDER BY id", url => $dsn)
    assert_eq scalar(@names), 3, "query_col: 3 names"
    assert_eq $names[0], "alice", "query_col: first=alice"

    # schema
    val $sch = Postgres::schema($tbl, url => $dsn)
    assert_eq ref($sch->{columns}), "ARRAY", "schema: columns is array"
    assert_eq scalar(@{$sch->{columns}}), 4, "schema: 4 columns"

    # tables list contains ours (names come back schema-qualified, e.g.
    # "public.<table>")
    val @tables = Postgres::tables(url => $dsn)
    val $found = grep { $_ eq $tbl || $_ =~ /\.\Q$tbl\E$/ } @tables
    assert_ok $found, "tables: contains $tbl"

    # insert_many
    val $im = Postgres::insert_many($tbl,
        [{ name => "dana", score => 4.0, payload => { color => "purple" } },
         { name => "eve",  score => 5.5, payload => { color => "yellow" } }],
        url => $dsn,
    )
    assert_eq $im, 2, "insert_many: inserted=2"

    # insert_many with RETURNING — generated IDs come back as rows
    val @returned = Postgres::insert_many($tbl,
        [{ name => "frank", score => 6.0, payload => { color => "orange" } }],
        url => $dsn,
        returning => "id",
    )
    assert_eq scalar(@returned), 1, "insert_many RETURNING: 1 row back"
    assert_ok defined $returned[0]->{id}, "insert_many RETURNING: id defined"

    # ── count + table_exists + truncate ──────────────────────────────
    val $n0 = Postgres::count($tbl, undef, url => $dsn)
    assert_ok $n0 > 0, "count returns the row total"
    assert_eq Postgres::count($tbl, "name = 'alice'", url => $dsn), 1, "count honors a WHERE clause"
    assert_ok  Postgres::table_exists($tbl, url => $dsn), "table_exists true for our table"
    assert_ok !Postgres::table_exists("nope_$$", url => $dsn), "table_exists false for an absent table"
    assert_ok  Postgres::exists($tbl, undef, url => $dsn), "exists: true when the table has rows"
    assert_ok  Postgres::exists($tbl, "name = 'alice'", url => $dsn), "exists: true for a matching WHERE"
    assert_ok !Postgres::exists($tbl, "name = 'nobody'", url => $dsn), "exists: false for a non-matching WHERE"
    assert_ok  Postgres::exists($tbl, "name = \$1", url => $dsn, bind => ["alice"]), "exists: honors a bind param"
    assert_ok !Postgres::exists($tbl, "name = \$1", url => $dsn, bind => ["nobody"]), "exists: bind param, no match"

    # ── update + delete (bound SET, interpolated WHERE) ───────────────
    val $crud = "stryke_pg_crud_$$"
    Postgres::execute("DROP TABLE IF EXISTS $crud", url => $dsn)
    Postgres::execute("CREATE TABLE $crud (id INT, name TEXT, hits INT)", url => $dsn)
    Postgres::insert_many($crud,
        [{ id => 1, name => "a", hits => 1 },
         { id => 2, name => "b", hits => 2 },
         { id => 3, name => "c", hits => 3 }], url => $dsn)
    assert_eq Postgres::update($crud, { name => "B", hits => 9 }, "id = 2", url => $dsn), 1,
        "update: one matching row affected"
    val $u = Postgres::query_one("SELECT name, hits FROM $crud WHERE id = 2", url => $dsn)
    assert_eq $u->{name}, "B", "update: SET applied to name"
    assert_eq $u->{hits}, 9, "update: SET applied to hits"
    assert_eq Postgres::update($crud, { hits => 0 }, undef, url => $dsn), 3,
        "update: no WHERE touches every row"
    assert_eq Postgres::query_scalar("SELECT sum(hits) FROM $crud", url => $dsn), 0,
        "update: all hits zeroed"
    assert_eq Postgres::delete($crud, "id = 1", url => $dsn), 1, "delete: one matching row"
    assert_eq Postgres::count($crud, undef, url => $dsn), 2, "delete: count reflects removal"
    assert_eq Postgres::delete($crud, undef, url => $dsn), 2, "delete: no WHERE removes the rest"
    assert_eq Postgres::count($crud, undef, url => $dsn), 0, "delete: table now empty"
    eval { Postgres::execute("DROP TABLE $crud", url => $dsn) }

    # ── transaction: commit path ─────────────────────────────────────
    Postgres::transaction(fn {
        Postgres::execute("INSERT INTO $tbl (name, score) VALUES ('txn-a', 9)", url => $dsn)
        Postgres::execute("INSERT INTO $tbl (name, score) VALUES ('txn-b', 9)", url => $dsn)
    }, url => $dsn)
    assert_eq Postgres::count($tbl, "score = 9", url => $dsn), 2, "transaction commits both inserts"

    # ── transaction: rollback path (a die inside undoes the work) ─────
    val $before = Postgres::count($tbl, undef, url => $dsn)
    val $threw  = !eval {
        Postgres::transaction(fn {
            Postgres::execute("INSERT INTO $tbl (name, score) VALUES ('doomed', 1)", url => $dsn)
            die "boom"
        }, url => $dsn)
        1
    }
    assert_ok $threw, "transaction re-raises the inner die"
    assert_eq Postgres::count($tbl, undef, url => $dsn), $before, "rollback undid the failed insert"
    assert_eq Postgres::count($tbl, "name = 'doomed'", url => $dsn), 0, "doomed row never persisted"

    # ── truncate empties the table ────────────────────────────────────
    Postgres::truncate($tbl, url => $dsn)
    assert_eq Postgres::count($tbl, undef, url => $dsn), 0, "truncate empties the table"

    # ── upsert: insert, update-on-conflict, DO NOTHING, RETURNING ─────
    val $kv = "stryke_pg_upsert_$$"
    Postgres::execute("DROP TABLE IF EXISTS $kv", url => $dsn)
    Postgres::execute("CREATE TABLE $kv (id INT PRIMARY KEY, name TEXT, hits INT)", url => $dsn)

    # first call inserts (integer bind against an INT4 column)
    assert_eq Postgres::upsert($kv, { id => 1, name => "a", hits => 1 },
        conflict => ["id"], url => $dsn), 1, "upsert: insert path affected=1"
    assert_eq Postgres::query_scalar("SELECT hits FROM $kv WHERE id = 1", url => $dsn), 1,
        "upsert: inserted value present"

    # conflicting call updates all non-key columns by default
    Postgres::upsert($kv, { id => 1, name => "A", hits => 9 }, conflict => ["id"], url => $dsn)
    val $r = Postgres::query_one("SELECT name, hits FROM $kv WHERE id = 1", url => $dsn)
    assert_eq $r->{name}, "A", "upsert: default update overwrote name"
    assert_eq $r->{hits}, 9, "upsert: default update overwrote hits"

    # explicit update list touches only the named columns
    Postgres::upsert($kv, { id => 1, name => "ignored", hits => 42 },
        conflict => ["id"], update => ["hits"], url => $dsn)
    val $r2 = Postgres::query_one("SELECT name, hits FROM $kv WHERE id = 1", url => $dsn)
    assert_eq $r2->{name}, "A", "upsert: explicit update kept name"
    assert_eq $r2->{hits}, 42, "upsert: explicit update bumped hits"

    # empty update list = DO NOTHING — the conflicting row is left untouched
    Postgres::upsert($kv, { id => 1, name => "nope", hits => 0 },
        conflict => ["id"], update => [], url => $dsn)
    assert_eq Postgres::query_scalar("SELECT hits FROM $kv WHERE id = 1", url => $dsn), 42,
        "upsert: DO NOTHING left the row unchanged"

    # RETURNING gives the affected rows back
    val @ret = Postgres::upsert($kv, { id => 2, name => "b", hits => 5 },
        conflict => ["id"], returning => "id,name", url => $dsn)
    assert_eq scalar(@ret), 1, "upsert RETURNING: 1 row back"
    assert_eq $ret[0]->{name}, "b", "upsert RETURNING: row payload"

    # a conflict-target naming an invalid identifier is rejected
    val $bad = !eval {
        Postgres::upsert($kv, { id => 3 }, conflict => ["id; DROP TABLE $kv; --"], url => $dsn)
        1
    }
    assert_ok $bad, "upsert: rejects an injection conflict identifier"

    eval { Postgres::execute("DROP TABLE $kv", url => $dsn) }

    eval { Postgres::execute("DROP TABLE $tbl", url => $dsn) }
}

# ── pure helpers (no connection — always run) ────────────────────────
val $p = Postgres::parse_dsn("postgresql://alice:s3cret\@db.example.com:6543/analytics?sslmode=require")
assert_eq $p->{user},   "alice",           "parse_dsn: user"
assert_eq $p->{password}, "s3cret",        "parse_dsn: password"
assert_eq $p->{host},   "db.example.com",  "parse_dsn: host"
assert_eq $p->{port},   6543,              "parse_dsn: port"
assert_eq $p->{dbname}, "analytics",       "parse_dsn: dbname"
assert_eq $p->{params}{sslmode}, "require", "parse_dsn: param"

# percent-encoded @ in password must survive the round trip
val $built = Postgres::build_dsn(user => "u", password => "p\@ss", host => "127.0.0.1", port => 5432, dbname => "app")
val $rt = Postgres::parse_dsn($built)
assert_eq $rt->{password}, "p\@ss", "build_dsn → parse_dsn round-trips the @ password"
assert_eq $rt->{dbname},   "app",   "build_dsn → parse_dsn dbname"

assert_eq Postgres::quote_ident("weird\"col"), "\"weird\"\"col\"", "quote_ident doubles quotes"
assert_eq Postgres::quote_literal("O'Brien"),  "'O''Brien'",       "quote_literal doubles apostrophes"

# escape_like: backslash-escape the LIKE wildcards % _ and the escape char \.
assert_eq Postgres::escape_like("plain"),  "plain",         "escape_like: plain text unchanged"
assert_eq Postgres::escape_like("100%"),   "100\\%",        "escape_like: percent wildcard escaped"
assert_eq Postgres::escape_like("a_b"),    "a\\_b",         "escape_like: underscore wildcard escaped"
assert_eq Postgres::escape_like("a\\b"),   "a\\\\b",        "escape_like: the escape char itself is doubled"
assert_eq Postgres::escape_like("50%_x"),  "50\\%\\_x",     "escape_like: both wildcards in one value"

# unescape_like: inverse of escape_like — recover the literal.
assert_eq Postgres::unescape_like("plain"),     "plain", "unescape_like: plain text unchanged"
assert_eq Postgres::unescape_like("100\\%"),    "100%",  "unescape_like: escaped percent decodes to literal"
assert_eq Postgres::unescape_like("a\\_b"),     "a_b",   "unescape_like: escaped underscore decodes to literal"
assert_eq Postgres::unescape_like("a\\\\b"),    "a\\b",  "unescape_like: doubled backslash decodes to one"
assert_eq Postgres::unescape_like(Postgres::escape_like("50%_off\\sale")), "50%_off\\sale", "unescape_like: round-trips escape_like"
assert_dies fn { Postgres::unescape_like("a%b") },   "unescape_like: rejects an unescaped wildcard"
assert_dies fn { Postgres::unescape_like("trail\\") }, "unescape_like: rejects a dangling backslash"

# unquote_ident: inverse of quote_ident (strip quotes, un-double "").
assert_eq Postgres::unquote_ident("\"weird\"\"col\""), "weird\"col", "unquote_ident: doubled quote decodes to one"
assert_eq Postgres::unquote_ident("\"plain\""),        "plain",      "unquote_ident: plain quoted name"
assert_eq Postgres::unquote_ident(Postgres::quote_ident("has space")), "has space", "unquote_ident: round-trips quote_ident"
assert_dies fn { Postgres::unquote_ident("plain") },     "unquote_ident: rejects an unquoted name"
assert_dies fn { Postgres::unquote_ident("\"a\"b\"") },  "unquote_ident: rejects an unpaired quote"

# quote_nullable: like quote_literal but undef → NULL.
assert_eq Postgres::quote_nullable("O'Brien"), "'O''Brien'",       "quote_nullable: quotes a string like quote_literal"
assert_eq Postgres::quote_nullable(undef),     "NULL",             "quote_nullable: undef → unquoted NULL"
assert_eq Postgres::quote_nullable(),          "NULL",             "quote_nullable: no argument → NULL"

# unquote_literal: inverse of quote_literal (standard mode).
assert_eq Postgres::unquote_literal("'O''Brien'"), "O'Brien", "unquote_literal: un-doubles the quote"
assert_eq Postgres::unquote_literal("''"), "",               "unquote_literal: empty literal"
assert_eq Postgres::unquote_literal("'plain'"), "plain",     "unquote_literal: plain literal"
assert_eq Postgres::unquote_literal(Postgres::quote_literal("a'b'c")), "a'b'c", "unquote_literal: round-trips quote_literal"
assert_dies fn { Postgres::unquote_literal("noquotes") }, "unquote_literal: rejects a non-quoted value"
assert_dies fn { Postgres::unquote_literal("'a'b'") }, "unquote_literal: rejects an unpaired internal quote"

# dollar_quote: $tag$...$tag$ wrapping with an auto non-colliding tag.
assert_eq Postgres::dollar_quote(q{Dianne's horse}), q{$$Dianne's horse$$}, "dollar_quote: empty tag when no collision"
assert_eq Postgres::dollar_quote(q{a $$ b}),          q{$dq0$a $$ b$dq0$},  "dollar_quote: auto tag avoids the $$ collision"
assert_eq Postgres::dollar_quote(q{body}, q{fn}),     q{$fn$body$fn$},      "dollar_quote: explicit tag"
assert_dies fn { Postgres::dollar_quote(q{has $fn$ inside}, q{fn}) }, "dollar_quote: explicit tag colliding with content dies"
assert_dies fn { Postgres::dollar_quote(q{x}, q{bad$tag}) }, "dollar_quote: a tag with a dollar sign dies"

# unquote_dollar: inverse of dollar_quote.
assert_eq Postgres::unquote_dollar(q{$$Dianne's horse$$}), q{Dianne's horse}, "unquote_dollar: empty tag, content verbatim"
assert_eq Postgres::unquote_dollar(q{$fn$body$fn$}),       q{body},           "unquote_dollar: named tag"
assert_eq Postgres::unquote_dollar(q{$$$$}),               q{},               "unquote_dollar: empty body"
assert_eq Postgres::unquote_dollar(q{$outer$ has $$ and $5 $outer$}), q{ has $$ and $5 }, "unquote_dollar: inner $$ / $5 stay literal under a named tag"
# Round-trips dollar_quote, including the auto-tag path.
for val $raw (q{plain}, q{Dianne's}, q{a $$ b}, q{x $$ y $dq0$ z}) {
    assert_eq Postgres::unquote_dollar(Postgres::dollar_quote($raw)), $raw, "unquote_dollar: round-trips dollar_quote($raw)"
}
assert_dies fn { Postgres::unquote_dollar(q{noquotes}) },        "unquote_dollar: rejects a non-dollar-quoted string"
assert_dies fn { Postgres::unquote_dollar(q{$fn$body$other$}) }, "unquote_dollar: rejects a mismatched closing tag"

# quote_qualified_ident: each dot-separated segment quoted independently.
assert_eq Postgres::quote_qualified_ident("public.my table"), "\"public\".\"my table\"", "quote_qualified_ident quotes each segment"
assert_eq Postgres::quote_qualified_ident("users"), "\"users\"", "quote_qualified_ident: bare identifier still quoted"
assert_dies fn { Postgres::quote_qualified_ident("public.") }, "quote_qualified_ident rejects empty trailing segment"

# parse_qualified_ident: inverse of quote_qualified_ident.
val $segs = Postgres::parse_qualified_ident("\"public\".\"my table\"")
assert_eq scalar(@$segs), 2,       "parse_qualified_ident: two segments"
assert_eq $segs->[0], "public",    "parse_qualified_ident: first segment"
assert_eq $segs->[1], "my table",  "parse_qualified_ident: quoted segment keeps the space"
assert_eq Postgres::parse_qualified_ident("\"a.b\".\"c\"")->[0], "a.b", "parse_qualified_ident: dot inside quotes is literal"
assert_eq Postgres::parse_qualified_ident("\"we\"\"ird\"")->[0], "we\"ird", "parse_qualified_ident: doubled quote decodes to one"
# round-trips quote_qualified_ident.
assert_eq Postgres::parse_qualified_ident(Postgres::quote_qualified_ident("public.my table"))->[1], "my table", "parse_qualified_ident: round-trips quote_qualified_ident"
assert_dies fn { Postgres::parse_qualified_ident("a..b") }, "parse_qualified_ident: rejects an empty segment"

# format_array: Postgres array literal with selective element quoting.
assert_eq Postgres::format_array(["a", "b", "c"]), "{a,b,c}", "format_array: plain tokens stay bare"
assert_eq Postgres::format_array(["a,b", "c d", "NULL"]), "{\"a,b\",\"c d\",\"NULL\"}", "format_array: comma/space/NULL forced to quote"
assert_eq Postgres::format_array([]), "{}", "format_array: empty list"

# format_in_list: parenthesized IN-clause operand (mixed types via quote_literal).
assert_eq Postgres::format_in_list([1, 2, 3]),       "(1, 2, 3)",          "format_in_list: bare numbers"
assert_eq Postgres::format_in_list(["a", q{O'Brien}]), q{('a', 'O''Brien')}, "format_in_list: strings quoted, '' doubled"
assert_eq Postgres::format_in_list([1, "a", undef]), "(1, 'a', NULL)",      "format_in_list: mixed number/string/undef"
assert_eq Postgres::format_in_list([]),              "(NULL)",              "format_in_list: empty → (NULL)"
assert_dies fn { Postgres::format_in_list() }, "format_in_list: dies without values"

# parse_in_list: inverse of format_in_list.
assert_eq join(",", @{ Postgres::parse_in_list("(1, 2, 3)") }), "1,2,3", "parse_in_list: bare numbers"
val $pil = Postgres::parse_in_list(q{('a', 'O''Brien')})
assert_eq $pil->[1], q{O'Brien}, "parse_in_list: '' un-doubles inside a quoted element"
val $rt = Postgres::parse_in_list(Postgres::format_in_list([1, "a", undef]))
assert_eq $rt->[0], 1,       "parse_in_list: round-trips a number"
assert_eq $rt->[1], "a",     "parse_in_list: round-trips a string"
assert_ok !defined($rt->[2]), "parse_in_list: round-trips NULL → undef"
assert_eq Postgres::parse_in_list("(1.5, 'a,b')")->[1], "a,b", "parse_in_list: comma inside quotes does not split"
assert_dies fn { Postgres::parse_in_list("1, 2, 3") }, "parse_in_list: rejects a non-parenthesized list"

# parse_array: Postgres array literal → arrayref (inverse of format_array).
val $pa = Postgres::parse_array("{\"a,b\",\"c d\",\"NULL\",ok}")
assert_eq $pa->[0], "a,b",  "parse_array: quoted comma element"
assert_eq $pa->[1], "c d",  "parse_array: quoted space element"
assert_eq $pa->[2], "NULL", "parse_array: quoted NULL stays string"
assert_eq $pa->[3], "ok",   "parse_array: bare element"
val $nul = Postgres::parse_array("{a,NULL,b}")
assert_ok !defined($nul->[1]), "parse_array: unquoted NULL is undef"
assert_eq scalar(@{Postgres::parse_array("{}")}), 0, "parse_array: empty array → empty list"
# round-trip through format_array.
val @src = ("a,b", "c d", "ok")
assert_eq Postgres::parse_array(Postgres::format_array(\@src))->[0], "a,b", "parse_array: round-trips format_array"
assert_dies fn { Postgres::parse_array("a,b,c") }, "parse_array: rejects non-array-literal"

assert_dies fn { Postgres::parse_dsn("host=localhost dbname=x") }, "parse_dsn rejects keyword/value form"

test_run
