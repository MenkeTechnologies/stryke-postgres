# t/test_postgres.stk — round-trip tests against a live Postgres.
#
# Requires the cdylib to be loaded. Install once with `s pkg install -g .`
# from the package root so stryke's FFI bridge dlopens
# lib/libstryke_postgres.{dylib,so} on `use Postgres`.

use Postgres

val $have_cdylib = eval { Postgres::version(); 1 }
val $dsn = $ENV{DATABASE_URL} // $ENV{POSTGRES_URL} // $ENV{POSTGRES_DSN}

unless ($have_cdylib) {
    p "1..0 # SKIP cdylib not loaded — run `s pkg install -g .` first"
    exit 0
}
unless (defined $dsn && $dsn ne "") {
    p "1..0 # SKIP \$DATABASE_URL not set"
    exit 0
}
unless (eval { Postgres::ping(url => $dsn) }) {
    p "1..0 # SKIP cannot connect to $dsn"
    exit 0
}

val $tbl = "stryke_postgres_test_$$"
p "1..11"
var $i = 0

eval { Postgres::execute("DROP TABLE IF EXISTS $tbl", dsn => $dsn) }
var $r
eval {
    $r = Postgres::execute(
        "CREATE TABLE $tbl (id SERIAL PRIMARY KEY, name TEXT, score DOUBLE PRECISION, payload JSONB)",
        dsn => $dsn,
    )
}
$i++
p $@ ? "not ok $i - create table: $@" : "ok $i - create table"

eval {
    $r = Postgres::execute(
        "INSERT INTO $tbl (name, score, payload) VALUES (\$1,\$2,\$3),(\$4,\$5,\$6),(\$7,\$8,\$9)",
        dsn  => $dsn,
        bind => ["alice", 1.5, {color => "blue"},
                 "bob",   2.0, {color => "red"},
                 "charlie", 3.25, {color => "green"}],
    )
}
$i++
p $@ ? "not ok $i - insert: $@" :
       ($r->{affected_rows} == 3 ? "ok $i - insert 3 rows" :
        "not ok $i - insert affected=$r->{affected_rows}")

var @rows
eval { @rows = Postgres::query("SELECT * FROM $tbl ORDER BY id", dsn => $dsn) }
$i++
p $@ ? "not ok $i - select: $@" :
       (len(@rows) == 3 ? "ok $i - select 3 rows" :
        "not ok $i - select got " . len(@rows) . " rows")

eval { @rows = Postgres::query("SELECT * FROM $tbl WHERE name = \$1", dsn => $dsn, bind => ["bob"]) }
$i++
p $@ ? "not ok $i - bind query: $@" :
       (len(@rows) == 1 && $rows[0]->{name} eq "bob"
            ? "ok $i - bind query"
            : "not ok $i - bind query wrong shape")

var $scalar
eval { $scalar = Postgres::query_scalar("SELECT COUNT(*) AS n FROM $tbl", dsn => $dsn) }
$i++
p $@ ? "not ok $i - query_scalar: $@" :
       ($scalar == 3 ? "ok $i - query_scalar" : "not ok $i - query_scalar got $scalar")

var $one
eval { $one = Postgres::query_one("SELECT * FROM $tbl WHERE name = \$1", dsn => $dsn, bind => ["alice"]) }
$i++
p $@ ? "not ok $i - query_one: $@" :
       (defined $one && $one->{name} eq "alice" && $one->{payload}->{color} eq "blue"
            ? "ok $i - query_one (jsonb decoded)"
            : "not ok $i - query_one wrong")

var @col
eval { @col = Postgres::query_col("SELECT name FROM $tbl ORDER BY id", dsn => $dsn) }
$i++
p $@ ? "not ok $i - query_col: $@" :
       (len(@col) == 3 && $col[0] eq "alice"
            ? "ok $i - query_col"
            : "not ok $i - query_col wrong")

var $sch
eval { $sch = Postgres::schema($tbl, dsn => $dsn) }
$i++
p $@ ? "not ok $i - schema: $@" :
       (ref($sch->{columns}) eq "ARRAY" && len(@{$sch->{columns}}) == 4
            ? "ok $i - schema (4 cols)"
            : "not ok $i - schema bad shape")

var @tables
eval { @tables = Postgres::tables(dsn => $dsn) }
$i++
if ($@) {
    p "not ok $i - tables: $@"
} else {
    var $found = 0
    for val $t (@tables) {
        $found = 1 if $t eq $tbl
    }
    p ($found ? "ok $i - tables (found $tbl)"
              : "not ok $i - tables missing $tbl (saw " . len(@tables) . " total)")
}

var $r2
eval {
    $r2 = Postgres::insert_many($tbl,
        [{ name => "dana", score => 4.0, payload => { color => "purple" } },
         { name => "eve",  score => 5.5, payload => { color => "yellow" } }],
        dsn => $dsn,
    )
}
$i++
p $@ ? "not ok $i - insert_many: $@" :
       ($r2->{affected_rows} == 2 ? "ok $i - insert_many" : "not ok $i - insert_many wrong count")

# RETURNING — verify generated IDs come back as rows.
var @returned
eval {
    @returned = Postgres::insert_many($tbl,
        [{ name => "frank", score => 6.0, payload => { color => "orange" } }],
        dsn => $dsn,
        returning => "id",
    )
}
$i++
p $@ ? "not ok $i - insert_many returning: $@" :
       (len(@returned) == 1 && defined $returned[0]->{id}
            ? "ok $i - insert_many returning id=$returned[0]->{id}"
            : "not ok $i - insert_many returning wrong shape")

eval { Postgres::execute("DROP TABLE $tbl", dsn => $dsn) }
