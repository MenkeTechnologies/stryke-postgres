## t/test_stryke_postgres_surface.stk — wrapper-completeness pin.
##
## Asserts every public `fn X::Y::name` declared in lib/*.stk is
## reachable via `use` at runtime. Uses `exists &X::Y::name` to
## probe the symbol table without invoking the sub.
##
## Catches:
##   * a wrapper sub deleted from lib/ but still referenced elsewhere
##   * a sub-package file dropped from the install layout
##   * `use Foo::Bar` failing to chase into lib/Bar.stk
##   * an installed-package entry whose namespace bridge is broken
##
## Permission-free — no service, no creds, no live daemon. Private
## helpers (`_` prefix) are implementation detail and are NOT
## asserted, so refactoring internals stays free.

use Postgres

# ── Postgres.stk ──────────────────────────────────────────────
assert_ok exists &Postgres::version, "Postgres::version exists"
assert_ok exists &Postgres::server_version, "Postgres::server_version exists"
assert_ok exists &Postgres::ping, "Postgres::ping exists"
assert_ok exists &Postgres::databases, "Postgres::databases exists"
assert_ok exists &Postgres::tables, "Postgres::tables exists"
assert_ok exists &Postgres::schema, "Postgres::schema exists"
assert_ok exists &Postgres::query, "Postgres::query exists"
assert_ok exists &Postgres::query_one, "Postgres::query_one exists"
assert_ok exists &Postgres::query_col, "Postgres::query_col exists"
assert_ok exists &Postgres::query_scalar, "Postgres::query_scalar exists"
assert_ok exists &Postgres::query_stream, "Postgres::query_stream exists"
assert_ok exists &Postgres::dump, "Postgres::dump exists"
assert_ok exists &Postgres::execute, "Postgres::execute exists"
assert_ok exists &Postgres::exec_file, "Postgres::exec_file exists"
assert_ok exists &Postgres::insert_many, "Postgres::insert_many exists"
assert_ok exists &Postgres::copy_in, "Postgres::copy_in exists"
assert_ok exists &Postgres::copy_out, "Postgres::copy_out exists"
assert_ok exists &Postgres::notify, "Postgres::notify exists"
assert_ok exists &Postgres::listen, "Postgres::listen exists"
assert_ok exists &Postgres::upsert, "Postgres::upsert exists"
assert_ok exists &Postgres::begin, "Postgres::begin exists"
assert_ok exists &Postgres::commit, "Postgres::commit exists"
assert_ok exists &Postgres::rollback, "Postgres::rollback exists"
assert_ok exists &Postgres::transaction, "Postgres::transaction exists"
assert_ok exists &Postgres::count, "Postgres::count exists"
assert_ok exists &Postgres::table_exists, "Postgres::table_exists exists"
assert_ok exists &Postgres::exists, "Postgres::exists exists"
assert_ok exists &Postgres::update, "Postgres::update exists"
assert_ok exists &Postgres::delete, "Postgres::delete exists"
assert_ok exists &Postgres::truncate, "Postgres::truncate exists"

# ── Postgres.stk introspection extras ──
assert_ok exists &Postgres::explain, "Postgres::explain exists"
assert_ok exists &Postgres::views, "Postgres::views exists"
assert_ok exists &Postgres::functions, "Postgres::functions exists"
assert_ok exists &Postgres::indexes, "Postgres::indexes exists"
assert_ok exists &Postgres::roles, "Postgres::roles exists"
assert_ok exists &Postgres::db_size, "Postgres::db_size exists"

assert_ok exists &Postgres::activity, "Postgres::activity exists"
assert_ok exists &Postgres::locks, "Postgres::locks exists"
assert_ok exists &Postgres::table_size, "Postgres::table_size exists"
assert_ok exists &Postgres::sequences, "Postgres::sequences exists"
assert_ok exists &Postgres::extensions, "Postgres::extensions exists"
assert_ok exists &Postgres::triggers, "Postgres::triggers exists"
assert_ok exists &Postgres::cancel_backend, "Postgres::cancel_backend exists"

# ── pure DSN/quoting helpers ──
assert_ok exists &Postgres::parse_dsn, "Postgres::parse_dsn exists"
assert_ok exists &Postgres::build_dsn, "Postgres::build_dsn exists"
assert_ok exists &Postgres::quote_ident, "Postgres::quote_ident exists"
assert_ok exists &Postgres::unquote_ident, "Postgres::unquote_ident exists"
assert_ok exists &Postgres::quote_qualified_ident, "Postgres::quote_qualified_ident exists"
assert_ok exists &Postgres::parse_qualified_ident, "Postgres::parse_qualified_ident exists"
assert_ok exists &Postgres::quote_literal, "Postgres::quote_literal exists"
assert_ok exists &Postgres::quote_nullable, "Postgres::quote_nullable exists"
assert_ok exists &Postgres::unquote_literal, "Postgres::unquote_literal exists"
assert_ok exists &Postgres::dollar_quote, "Postgres::dollar_quote exists"
assert_ok exists &Postgres::format_array, "Postgres::format_array exists"
assert_ok exists &Postgres::parse_array, "Postgres::parse_array exists"

test_run
