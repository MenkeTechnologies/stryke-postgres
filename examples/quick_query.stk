#!/usr/bin/env stryke
# examples/quick_query.stk — pull a few rows from Postgres.
#
# Run:   POSTGRES_DSN='postgres://user@host/db' s examples/quick_query.stk

use Postgres

val $dsn = $ENV{POSTGRES_DSN} // $ENV{DATABASE_URL}
unless (defined $dsn) {
    p "set \$POSTGRES_DSN or \$DATABASE_URL to a postgres connection URL to exercise the demo"
    exit 0
}

p "databases: " . join(", ", Postgres::databases(url => $dsn))
p "tables:    " . join(", ", Postgres::tables(url => $dsn))

var @rows = Postgres::query(
    "SELECT current_user AS who, current_database() AS db, version() AS v",
    url => $dsn,
)
for val $r (@rows) {
    p "user=$r->{who} db=$r->{db}"
    p "version: " . substr($r->{v}, 0, 60) . "..."
}
