#!/usr/bin/env stryke
# examples/quick_query.stk — pull a few rows from Postgres.
#
# Run:   POSTGRES_DSN='postgres://user@host/db' s examples/quick_query.stk

use Postgres

my $dsn = $ENV{POSTGRES_DSN} // $ENV{DATABASE_URL}
die "set \$POSTGRES_DSN\n" unless defined $dsn

p "databases: " . join(", ", Postgres::databases(dsn => $dsn))
p "tables:    " . join(", ", Postgres::tables(dsn => $dsn))

my @rows = Postgres::query(
    "SELECT current_user AS who, current_database() AS db, version() AS v",
    dsn => $dsn,
)
for my $r (@rows) {
    p "user=$r->{who} db=$r->{db}"
    p "version: " . substr($r->{v}, 0, 60) . "..."
}
