#!/usr/bin/env stryke
# examples/bulk_load.stk — load an array of hashes into a Postgres table.
#
# Run:   POSTGRES_DSN='postgres://…' s examples/bulk_load.stk

use Postgres

val $dsn = $ENV{POSTGRES_DSN} // $ENV{DATABASE_URL}
unless (defined $dsn) {
    p "set \$POSTGRES_DSN or \$DATABASE_URL to a postgres connection URL to exercise the demo"
    exit 0
}

val $tbl = "stryke_demo_$$"

Postgres::execute("DROP TABLE IF EXISTS $tbl", dsn => $dsn)
Postgres::execute(
    "CREATE TABLE $tbl (id SERIAL PRIMARY KEY, name TEXT, v DOUBLE PRECISION, meta JSONB)",
    dsn => $dsn,
)

val @rows = map {
    {
        name => "row_$_",
        v    => $_ * 1.5,
        meta => { idx => $_, even => $_ % 2 == 0 },
    }
} (1:100)

# Without RETURNING — just the affected count.
val $r = Postgres::insert_many($tbl, \@rows, dsn => $dsn)
p "inserted #{$r->{affected_rows}} rows"

# With RETURNING — get generated IDs back.
val @returned = Postgres::insert_many(
    $tbl,
    [{ name => "with_id", v => 999.0, meta => { extra => "yes" } }],
    dsn       => $dsn,
    returning => "id, name",
)
p "returned: " . to_json \@returned

p "count: " . Postgres::query_scalar("SELECT COUNT(*) FROM $tbl", dsn => $dsn)
Postgres::execute("DROP TABLE $tbl", dsn => $dsn)
