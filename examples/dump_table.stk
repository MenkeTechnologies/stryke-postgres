#!/usr/bin/env stryke
# examples/dump_table.stk — stream a table to NDJSON on stdout.
#
# Run:   POSTGRES_DSN='postgres://…' s examples/dump_table.stk pg_class

use Postgres

val $tbl = $ARGV[0]
die "usage: dump_table.stk TABLE\n" unless defined $tbl

val $dsn = $ENV{POSTGRES_DSN} // $ENV{DATABASE_URL}
die "set \$POSTGRES_DSN\n" unless defined $dsn

val $n = Postgres::query_stream(
    "SELECT * FROM $tbl",
    dsn      => $dsn,
    callback => sub ($row) { p to_json $row },
)
warn "dumped $n rows\n"
